# Merge these settings into your existing backend/.env; retain your Firebase configuration.
RECEIPT_LLM_URL=http://127.0.0.1:8082/v1/chat/completions
RECEIPT_LLM_MODEL=receipts

# Required: fill in the actual GGUF paths. Quote paths containing spaces.
# Relative paths are resolved from backend/. Use an absolute path instead of ~.
RECEIPT_LLM_MODEL_PATH=
RECEIPT_LLM_MMPROJ_PATH=

# Optional launcher settings, matching the existing chat.sh defaults.
RECEIPT_LLM_GPU_LAYERS=99
RECEIPT_LLM_CONTEXT=40960
# If this changes, update the port in RECEIPT_LLM_URL too.
RECEIPT_LLM_PORT=8082
